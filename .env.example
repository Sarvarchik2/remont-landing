# --- Telegram lead delivery (required for the contact/calculator forms) ---
# 1. Create a bot: open @BotFather in Telegram → /newbot → copy the token
NUXT_TELEGRAM_BOT_TOKEN=123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 2. Get your chat id: message @userinfobot (personal) or add the bot to a
#    group and use the group id (starts with -100...). For a channel use its @username.
NUXT_TELEGRAM_CHAT_ID=123456789

# --- Optional external CMS/API ---
# Leave empty to render the built-in fallback content (services, portfolio, prices).
NUXT_PUBLIC_API_BASE=
NUXT_PUBLIC_SITE_URL=https://vicasa.uz
